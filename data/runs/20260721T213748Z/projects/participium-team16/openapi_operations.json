  {
    "operation_id": "getReportStats",
    "method": "GET",
    "path": "/reports/stats",
    "summary": "Get reports statistics",
    "description": "Retrieve various statistics about reports in the system. The filters can be applied using query parameters. Available filters include date range (`fromDate`, `toDate`), predefined periods (`period`), and report categories (`category`). For multiple categories use multiple `category` parameters, e.g., `category=sanification&category=infrastructure`.",
    "parameters": [
      {
        "in": "query",
        "name": "fromDate",
        "schema": {
          "type": "string",
          "format": "date-time"
        },
        "required": false,
        "description": "Start date for filtering reports (inclusive)"
      },
      {
        "in": "query",
        "name": "toDate",
        "schema": {
          "type": "string",
          "format": "date-time"
        },
        "required": false,
        "description": "End date for filtering reports (inclusive)"
      },
      {
        "in": "query",
        "name": "period",
        "schema": {
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "monthly",
            "yearly"
          ]
        },
        "required": false,
        "description": "Predefined period for filtering reports"
      },
      {
        "in": "query",
        "name": "category",
        "schema": {
          "$ref": "#/components/schemas/OfficeType"
        },
        "required": false,
        "description": "Filter reports by their state"
      }
    ],
    "request_body_schema": null,
    "response_codes": [
      "200",
      "default"
    ],
    "tags": [
      "Reports"
    ],
    "auth_required": null
  },
