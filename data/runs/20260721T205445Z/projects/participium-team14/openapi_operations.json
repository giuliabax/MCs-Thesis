    "operation_id": null,
    "method": "GET",
    "path": "/reports/search",
    "summary": "Search reports in a specific area",
    "description": "Return reports inside a geographica area\n",
    "parameters": [
      {
        "name": "bbox",
        "in": "query",
        "required": true,
        "description": "Bounding box in the format `minLng,minLat,maxLng,maxLat` (W,S,E,N)\n",
        "schema": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?,-?\\d+(\\.\\d+)?$"
        },
        "example": "7.6600,45.0600,7.6750,45.0700"
      }
    ],
