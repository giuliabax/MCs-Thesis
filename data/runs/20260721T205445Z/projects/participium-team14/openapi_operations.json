  {
    "operation_id": null,
    "method": "POST",
    "path": "/reports/{id}",
    "summary": "Change report status",
    "description": "Change the status of a report by ID. For rejection a motivation is required. Municipal public officer can also change the category of the report. **Requires role: MUNICIPALITY, EXTERNAL_MAINTAINER**.\n",
    "parameters": [
      {
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "type": "integer",
          "format": "int64"
        },
        "description": "Report ID"
      }
    ],
    "request_body_schema": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ASSIGNED",
            "REJECTED"
          ],
          "example": "REJECTED"
        },
        "motivation": {
          "type": "string",
          "example": "The report is not valid because photos are blurry."
        },
        "category": {
          "$ref": "#/components/schemas/ReportCategory"
        }
      }
    },
    "response_codes": [
      "204",
      "400",
      "401",
      "403",
      "404",
      "500"
    ],
    "tags": [
      "Reports"
    ],
    "auth_required": true
  },
