  "dependencies": [
    "POST /auth/users must precede authenticated user actions like GET /users/me",
    "POST /maintainers creates resources needed for PATCH/DELETE /maintainers/{id}",
    "POST /officers/assign-report is prerequisite for GET /maintainers/assigned and PATCH /maintainers/reports/{id}/status",
    "POST /reports creates resources needed for GET /reports, POST /reports/{id}/message, etc.",
    "POST /publics/assign-report enables GET /publics/retrievedocs and GET /officers/assigned",
    "POST /internal-messages enables GET /internal-messages/report/{reportId}",
    "POST /reports/{id}/follow enables GET /users/me/followed-reports",
    "POST /reports -> GET /internal-messages/report/{reportId}: A report must exist before an operation can address reportId.",
    "POST /auth/users -> GET /users/me: User must be authenticated to retrieve their profile",
    "POST /maintainers -> PATCH /maintainers/{id}: Maintainer must exist before updating",
    "POST /maintainers -> DELETE /maintainers/{id}: Maintainer must exist before deletion",
    "POST /reports -> GET /reports: Reports must exist to be retrieved or filtered",
    "POST /publics/assign-report -> GET /maintainers/assigned: Reports must be assigned to maintainer before retrieval",
    "POST /publics/assign-report -> PATCH /maintainers/reports/{id}/status: Report must be assigned before status update",
    "POST /officers/assign-report -> GET /publics/retrievedocs: Reports must be assigned to officer before retrieval",
    "POST /officers/assign-report -> GET /officers/assigned: Reports must be assigned to officer before retrieval",
    "POST /internal-messages -> GET /internal-messages/report/{reportId}: Messages must be sent before listing for a report",
    "POST /reports/{id}/follow -> GET /users/me/followed-reports: User must follow report before it appears in followed list"
  ],
