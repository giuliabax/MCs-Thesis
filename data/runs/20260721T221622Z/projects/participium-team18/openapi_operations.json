  },
  {
    "operation_id": null,
    "method": "GET",
    "path": "/internal/reports/assigned",
    "summary": "Get reports assigned to the authenticated user",
    "description": "Returns reports assigned to the current user.\nWorks for both **technical staff** and **external maintainers**.\n\n**For Technical Staff:**\n- Returns reports with status: Assigned, In Progress, Suspended, Delegated\n- Includes reports they have delegated (until reassigned)\n\n**For External Maintainers:**\n- Returns reports delegated to them (status: Delegated, In Progress, Suspended)\n- These are reports that municipality staff delegated to their company\n\nUse the optional `status` query parameter to filter by specific status.\n",
    "parameters": [
      {
        "in": "query",
        "name": "status",
        "schema": {
          "type": "string",
          "enum": [
            "Assigned",
            "In Progress",
            "Suspended",
            "Delegated",
            "Resolved"
          ]
        },
        "required": false,
        "description": "Optional filter by report status.\nCommon filters:\n- \"Delegated\" - External maintainers: see newly delegated reports\n- \"In Progress\" - See reports currently being worked on\n- \"Suspended\" - See paused reports\n",
        "example": "Delegated"
      }
    ],
    "request_body_schema": null,
    "response_codes": [
      "200",
      "401",
      "403"
    ],
    "tags": [
      "Internal"
    ],
    "auth_required": true
  },
