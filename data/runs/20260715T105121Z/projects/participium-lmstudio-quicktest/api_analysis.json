  "authentication_notes": [
    "POST /sessions creates the session token required for all authenticated endpoints.",
    "GET /sessions/current validates the current session state.",
    "DELETE /sessions/current invalidates the session token.",
    "Registration is public but subsequent profile access requires authentication.",
    "Admin endpoints require elevated privileges and valid sessions.",
    "Public report list (/reports/approved) does not require authentication.",
    "Operations marked auth_required need an authenticated session during test setup."
  ],
  "dependencies": [
    "Authentication flow (POST /sessions) must precede any authenticated resource access.",
    "Citizen registration (POST /registration) creates the record for profile updates.",
    "Verification code generation (POST /citizens/verification-code) is a prerequisite for email verification.",
    "Report creation (POST /reports) is required before status updates or assignments.",
    "Category listing (GET /categories) provides context for report creation and assignment.",
    "POST /reports -> GET /chats/{reportId}: A report must exist before an operation can address reportId.",
    "POST /reports -> POST /chats/{reportId}/read: A report must exist before an operation can address reportId.",
    "POST /sessions -> GET /sessions/current: Session token created by POST /sessions is required for GET /sessions/current.",
    "POST /registration -> GET /citizens: Citizen profile retrieval requires a registered citizen record.",
    "POST /citizens/verification-code -> POST /citizens/verify-email: Email verification requires an active verification code generated previously.",
    "POST /reports -> PUT /reports/{id}/status: Status update applies to an existing report resource created by POST /reports.",
    "POST /reports/{id}/internal-comments -> GET /reports/{id}/internal-comments: Listing comments requires the existence of the report and potentially prior comment creation.",
    "POST /reports/{id}/messages -> GET /reports/{id}/messages: Listing messages requires the existence of the report and potentially prior message creation."
  ],
