  "authentication_notes": [
    "/session sets HTTP-only secure cookie; /session/current validates session; all other endpoints require valid session unless explicitly marked auth_required: null",
    "Operations marked auth_required need an authenticated session during test setup."
  ],
  "dependencies": [
    "POST /session (login) is prerequisite for all authenticated operations",
    "POST /citizen/signup must precede POST /citizen/verify to activate account",
    "POST /telegram/generate-token must precede POST /telegram/link for Telegram linking flow",
    "POST /admin/municipality-users must precede GET/PUT/DELETE on municipality users",
    "POST /admin/external-companies must precede creation of external maintainers",
    "POST /reports (createReport) is prerequisite for all report-specific operations",
    "POST /reports -> GET /telegram/{telegramId}/reports/{reportId}: A report must exist before an operation can address reportId.",
    "POST /reports -> GET /reports/{reportId}/assignable-technicals: A report must exist before an operation can address reportId.",
    "POST /reports -> GET /reports/{reportId}/assignable-externals: A report must exist before an operation can address reportId.",
    "POST /reports -> POST /reports/{reportId}/assign-external: A report must exist before an operation can address reportId.",
    "POST /reports -> POST /reports/{reportId}/approve: A report must exist before an operation can address reportId.",
    "POST /reports -> POST /reports/{reportId}/reject: A report must exist before an operation can address reportId.",
    "POST /reports -> PATCH /reports/{reportId}/status: A report must exist before an operation can address reportId.",
    "POST /reports -> POST /reports/{reportId}/messages: A report must exist before an operation can address reportId.",
    "POST /reports -> GET /reports/{reportId}/messages: A report must exist before an operation can address reportId.",
    "POST /reports -> POST /reports/{reportId}/internal-notes: A report must exist before an operation can address reportId.",
    "POST /reports -> GET /reports/{reportId}/internal-notes: A report must exist before an operation can address reportId.",
    "POST /reports -> GET /reports/{reportId}: A report must exist before an operation can address reportId.",
    "POST /session -> GET /session/current: getSession requires active session created by login",
    "POST /citizen/signup -> POST /citizen/verify: verifyCitizenEmail requires unverified account created by signup",
    "POST /telegram/generate-token -> POST /telegram/link: linkTelegramAccount requires valid token generated by generate-token",
    "POST /admin/municipality-users -> GET /admin/municipality-users/{userId}: getMunicipalityUser requires existing user created by createMunicipalityUser",
    "POST /reports -> POST /reports/{reportId}/approve: approveReport requires pending report created by createReport"
  ],
  "dependency_edges": [
    {
      "prerequisite_method": "POST",
      "prerequisite_path": "/reports",
      "dependent_method": "GET",
      "dependent_path": "/telegram/{telegramId}/reports/{reportId}",
