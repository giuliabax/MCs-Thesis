      "dependencies": [],
      "notes": [
        "Login to the system",
        "Sets session cookie (connect.sid) in response headers",
        "Request body is documented in OpenAPI",
        "Documented responses: 200, 400, 401, 500"
      ]
    },
    {
      "path": "/session/current",
      "method": "GET",
      "operation_id": "getSession",
