      "type": "object",
      "properties": {
        "identifier": {
          "type": "string",
          "description": "Username or email"
        },
        "password": {
          "type": "string",
          "format": "password"
        },
        "csrfToken": {
          "type": "string"
        }
      }
    },
    "response_codes": [
      "200",
